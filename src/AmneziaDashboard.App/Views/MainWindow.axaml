<Window
    x:Class="AmneziaDashboard.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AmneziaDashboard.App.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="Amnezia Monitor"
    Width="1020"
    Height="650"
    MinWidth="900"
    MinHeight="560"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    Icon="avares://AmneziaMonitor/Assets/amnezia-monitor-icon.ico">

    <Window.Styles>

        <Style Selector="Button.NavButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button.NavButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.NavButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.NavButton:focus">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.NavButton:focus-visible">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.NavButton TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="Button.ActionButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.ActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="210,*" RowDefinitions="56,Auto,*">

        <!-- Sidebar -->
        <Border
            Grid.RowSpan="3"
            Background="{DynamicResource SidebarBackgroundBrush}">

            <Grid Margin="12" RowDefinitions="56,*,Auto">

                <!-- Logo -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

                    <Border
                        Width="34"
                        Height="34"
                        CornerRadius="8"
                        ClipToBounds="True">
                        <Image
                            Stretch="UniformToFill"
                            Source="avares://AmneziaMonitor/Assets/amnezia-monitor-icon.png" />
                    </Border>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Amnezia Monitor" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Spacing="4">

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowDashboardCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Nav.Overview}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowHistoryCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.History.Title}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowClientTrafficCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Traffic.Title}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowServersCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Nav.Servers}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowClientsCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Clients.Title}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowProtocolsCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Nav.Protocols}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowLogsCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Logs.Title}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowBackupCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Nav.Backup}" />
                    </Button>

                    <Button
                        Classes="NavButton"
                        Command="{Binding ShowSettingsCommand}">
                        <TextBlock Foreground="#E2E8F0" Text="{DynamicResource Loc.Nav.Settings}" />
                    </Button>

                </StackPanel>

                <!-- Footer -->
                <StackPanel
                    Grid.Row="2"
                    Margin="12,0,0,8"
                    Spacing="2">

                    <TextBlock
                        Foreground="{DynamicResource SidebarMutedBrush}"
                        FontSize="10"
                        Text="AMNEZIA MONITOR" />

                    <TextBlock
                        Foreground="{DynamicResource SidebarMutedBrush}"
                        FontSize="10"
                        Text="Version 1.4.0" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Top bar -->
        <Border
            Grid.Column="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{Binding Dashboard.ServerStatusBrush}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13"
                        Text="{Binding Dashboard.ServerStatus}" />
                </StackPanel>

                <ComboBox
                    x:Name="QuickServerComboBox"
                    Width="240"
                    Height="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    IsVisible="{Binding HasSavedServers}"
                    ItemsSource="{Binding Servers}"
                    SelectedItem="{Binding SelectedQuickServer, Mode=TwoWay}"
                    SelectionChanged="QuickServer_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerProfileItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{Binding StatusBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding Host}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        MaxWidth="180"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding QuickSwitchStatus}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="12"
                        Text="{Binding Dashboard.SshStatus}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="16,10,16,0"
            Padding="12,8"
            IsVisible="{Binding IsUpdateAvailable}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding UpdateBannerText}" />
                <Button
                    Grid.Column="1"
                    Height="30"
                    Padding="12,0"
                    Command="{Binding OpenUpdateReleaseCommand}"
                    Content="{DynamicResource Loc.Update.ViewRelease}" />
            </Grid>
        </Border>

        <!-- Content -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Margin="16"
            Background="Transparent">

            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

    </Grid>
</Window>
