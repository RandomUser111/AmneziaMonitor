<Window
    x:Class="AmneziaDashboard.App.Views.RevokeClientWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Отозвать доступ"
    Width="470"
    Height="365"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Icon="avares://AmneziaMonitor/Assets/amnezia-monitor-icon.ico"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="Отозвать VPN-доступ?" />

            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                TextWrapping="Wrap"
                Text="Peer будет удалён из активного интерфейса и серверной конфигурации." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0" Spacing="12">
            <Border
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Клиент" />
                    <TextBlock x:Name="ClientNameText" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="Протокол" />
                    <TextBlock x:Name="ProtocolText" Grid.Row="1" Grid.Column="1" />

                    <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="VPN IP" />
                    <TextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border
                Padding="12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusWarningBrush}"
                        Text="Перед изменением будет создана резервная копия" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Amnezia Monitor сохранит копии серверного .conf и clientsTable внутри VPN-контейнера. Сам клиентский конфиг на устройстве перестанет подключаться." />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Width="90"
                Height="36"
                Click="CancelButton_Click"
                Content="Отмена" />

            <Button
                Grid.Column="2"
                Width="145"
                Height="36"
                Background="{DynamicResource StatusErrorBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                Click="RevokeButton_Click"
                Content="Отозвать доступ" />
        </Grid>
    </Grid>
</Window>
