<UserControl
    x:Class="AmneziaDashboard.App.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AmneziaDashboard.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer>
        <StackPanel Spacing="14">

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Loc.Nav.Settings}" />

                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{DynamicResource Loc.Settings.Subtitle}" />
            </StackPanel>

            <Border
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Loc.Settings.Theme}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{DynamicResource Loc.Settings.ThemeDescription}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding CurrentTheme}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="36"
                            Padding="14,0"
                            Command="{Binding SetLightThemeCommand}"
                            Content="{DynamicResource Loc.Settings.Light}" />

                        <Button
                            Height="36"
                            Padding="14,0"
                            Command="{Binding SetDarkThemeCommand}"
                            Content="{DynamicResource Loc.Settings.Dark}" />

                        <Button
                            Height="36"
                            Padding="14,0"
                            Command="{Binding SetSystemThemeCommand}"
                            Content="{DynamicResource Loc.Settings.System}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Loc.Settings.Language}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{DynamicResource Loc.Settings.LanguageDescription}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding CurrentLanguage}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="36"
                            Padding="14,0"
                            Command="{Binding SetEnglishLanguageCommand}"
                            Content="English" />

                        <Button
                            Height="36"
                            Padding="14,0"
                            Command="{Binding SetRussianLanguageCommand}"
                            Content="Русский" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Loc.Settings.DesktopIntegration}" />
                    <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="{DynamicResource Loc.Settings.Notifications}" />
                    <CheckBox IsChecked="{Binding MinimizeToTray}" Content="{DynamicResource Loc.Settings.MinimizeToTray}" />
                    <CheckBox IsChecked="{Binding CloseToTray}" Content="{DynamicResource Loc.Settings.CloseToTray}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{DynamicResource Loc.Settings.TrayDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Loc.Settings.Updates}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{DynamicResource Loc.Settings.UpdatesDescription}"
                        TextWrapping="Wrap" />
                    <CheckBox IsChecked="{Binding AutomaticUpdateChecks}" Content="{DynamicResource Loc.Settings.AutomaticUpdateChecks}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding UpdateStatus}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="36"
                            Padding="14,0"
                            IsEnabled="{Binding CanCheckForUpdates}"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="{DynamicResource Loc.Settings.CheckForUpdates}" />
                        <Button
                            Height="36"
                            Padding="14,0"
                            IsVisible="{Binding CanOpenUpdate}"
                            Command="{Binding OpenUpdatePageCommand}"
                            Content="{DynamicResource Loc.Update.ViewRelease}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Loc.Settings.Storage}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{DynamicResource Loc.Settings.StorageDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
