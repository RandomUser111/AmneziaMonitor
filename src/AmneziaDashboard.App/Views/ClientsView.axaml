<UserControl
    x:Class="AmneziaDashboard.App.Views.ClientsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AmneziaDashboard.App.ViewModels"
    x:DataType="vm:ClientsViewModel"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Styles>
        <Style Selector="Button.ClientAction">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Клиенты" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="WireGuard / AmneziaWG" />

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="·" />

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Онлайн:" />

                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding ClientsOnline}" />

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="из" />

                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding ClientsTotal}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" VerticalAlignment="Bottom">
                <Button
                    Width="132"
                    Height="34"
                    Padding="12,0"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    IsEnabled="{Binding CanCreateClient}"
                    Click="CreateClient_Click"
                    Content="Новый клиент" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding MonitorStatus}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding OperationMessage}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Search/filter bar -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
                <TextBox
                    Height="34"
                    VerticalContentAlignment="Center"
                    PlaceholderText="Поиск по имени, IP, протоколу, endpoint или ключу"
                    Text="{Binding SearchText, Mode=TwoWay}" />

                <ComboBox
                    Grid.Column="1"
                    Height="34"
                    SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Все клиенты" />
                    <ComboBoxItem Content="Только онлайн" />
                    <ComboBoxItem Content="Только офлайн" />
                </ComboBox>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Margin="8,0,2,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="Автообновление: 5 сек" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="10">

            <Grid>
                <StackPanel
                    IsVisible="{Binding HasNoClients}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Нет данных о клиентах" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding EmptyMessage}" />
                </StackPanel>

                <StackPanel
                    IsVisible="{Binding HasNoVisibleClients}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Ничего не найдено" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Измените строку поиска или фильтр статуса." />
                </StackPanel>

                <Grid IsVisible="{Binding HasVisibleClients}" RowDefinitions="42,*">
                    <!-- Table header -->
                    <Border
                        Padding="12,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                        <Grid ColumnDefinitions="24,1.25*,0.9*,1*,0.8*,0.8*,0.8*,0.9*,120" ColumnSpacing="8">
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Клиент" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Протокол" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="VPN IP" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Handshake" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="↓ всего" />
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="↑ всего" />
                            <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Скорость" />
                            <TextBlock Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Действия" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FilteredClients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VpnClientViewModel">
                                    <Border
                                        Padding="12,9"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="24,1.25*,0.9*,1*,0.8*,0.8*,0.8*,0.9*,120" ColumnSpacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{Binding StatusBrush}"
                                                Text="●" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding StatusText}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Protocol}" />

                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Address}" />

                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding LastHandshake}" />

                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Text="{Binding Downloaded}" />

                                            <TextBlock
                                                Grid.Column="6"
                                                VerticalAlignment="Center"
                                                Text="{Binding Uploaded}" />

                                            <StackPanel Grid.Column="7" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontSize="11" Text="{Binding DownloadSpeed}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding UploadSpeed}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="8"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                                <Button
                                                    Classes="ClientAction"
                                                    ToolTip.Tip="Переименовать клиента"
                                                    Click="RenameClient_Click">
                                                    <PathIcon
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" />
                                                </Button>

                                                <Button
                                                    Classes="ClientAction"
                                                    ToolTip.Tip="Восстановить конфигурацию"
                                                    Background="Transparent"
                                                    Click="RestoreClientConfig_Click">
                                                    <PathIcon
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Data="M13,3 C8.03,3 4,7.03 4,12 L1,12 L5,16 L9,12 L6,12 C6,8.13 9.13,5 13,5 C16.87,5 20,8.13 20,12 C20,15.87 16.87,19 13,19 C10.79,19 8.82,17.97 7.54,16.36 L6.13,17.78 C7.77,19.74 10.23,21 13,21 C17.97,21 22,16.97 22,12 C22,7.03 17.97,3 13,3 Z" />
                                                </Button>

                                                <Button
                                                    Classes="ClientAction"
                                                    ToolTip.Tip="Отозвать доступ"
                                                    Background="Transparent"
                                                    Click="RevokeClient_Click">
                                                    <PathIcon
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{DynamicResource StatusErrorBrush}"
                                                        Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M8,9 L16,9 L16,19 L8,19 Z M15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
