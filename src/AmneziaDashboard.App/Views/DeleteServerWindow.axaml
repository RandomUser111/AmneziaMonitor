<Window
    x:Class="AmneziaDashboard.App.Views.DeleteServerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Loc.DeleteServer.Title}"
    Width="430"
    Height="235"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Icon="avares://AmneziaMonitor/Assets/amnezia-monitor-icon.ico"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5">
            <TextBlock
                FontSize="21"
                FontWeight="SemiBold"
                Text="{DynamicResource Loc.DeleteServer.Question}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource Loc.DeleteServer.SafeNote}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,18,0,0"
            Padding="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="ServerNameText"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="ServerAddressText"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Loc.DeleteServer.LocalOnly}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="1"
                Width="90"
                Height="36"
                Click="CancelButton_Click"
                Content="{DynamicResource Loc.Common.Cancel}" />
            <Button
                Grid.Column="2"
                Width="100"
                Height="36"
                Background="{DynamicResource StatusErrorBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                Click="DeleteButton_Click"
                Content="{DynamicResource Loc.Common.Delete}" />
        </Grid>
    </Grid>
</Window>
